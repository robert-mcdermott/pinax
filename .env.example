# Pinax settings. Copy to .env and change what you need; every value shown is the default.

# PINAX_ENVIRONMENT=demo

# Locations
# PINAX_VAR_ROOT=var
# PINAX_SCAN_ROOT=scans
# PINAX_DEMO_ROOT=demo
# PINAX_DATABASE_URL=
# PINAX_DB_AUTO_UPGRADE=true
# PINAX_DATABASE_POOL_SIZE=10

# Scanning
# PINAX_FS_INVENTORY=bin/fs-inventory
# PINAX_SCAN_THREADS=32
# PINAX_SCAN_EXTRA_ARGS=[]

# Building indexes
# PINAX_BUILD_MEMORY_LIMIT=8GB
# PINAX_BUILD_THREADS=0
# PINAX_KEEP_SNAPSHOTS=6

# Queries
# PINAX_QUERY_MEMORY_LIMIT=4GB
# PINAX_QUERY_THREADS=0
# PINAX_QUERY_TIMEOUT=180
# PINAX_WIDE_QUERIES=2
# PINAX_SEARCH_MAX_ROWS=500
# PINAX_EXPORT_MAX_ROWS=100000
# PINAX_COLD_DAYS=730
# PINAX_CURRENCY=USD
# PINAX_FILL_WARNING_MONTHS=12
# PINAX_JOB_TIMEOUT=3600
# PINAX_JOB_DAYS=7

# Identity: local (passwords Pinax keeps; the default outside the demo), demo (persona switcher; the default in the
# demo environment, refused in prod), or header (single sign-on proxy)
# PINAX_AUTH_MODE=local
# PINAX_AUTH_HEADER=X-Remote-User
# PINAX_TRUSTED_PROXIES='["127.0.0.1", "::1"]'
# Sign-in with Entra ID, or another OpenID Connect provider, in Pinax itself (PINAX_AUTH_MODE=oidc; docs/ENTRA-ID.md)
# PINAX_OIDC_ISSUER=https://login.microsoftonline.com/<tenant ID>/v2.0
# PINAX_OIDC_CLIENT_ID=
# PINAX_OIDC_CLIENT_SECRET=
# PINAX_OIDC_USERNAME_CLAIM=preferred_username
# PINAX_OIDC_USERNAME_DOMAINS=
# PINAX_PUBLIC_URL=
# PINAX_SESSION_SECRET=
# PINAX_SESSION_HOURS=12
# PINAX_LOGIN_MAX_FAILURES=5
# PINAX_LOGIN_LOCKOUT_MINUTES=15
# PINAX_PASSWORD_MIN_LENGTH=12
# PINAX_COOKIE_SECURE=

# API tokens for scripts: the longest one may last, in days
# PINAX_TOKEN_MAX_DAYS=365

# Logs: text or json, to standard error or a file; audit events to a file of their own too
# PINAX_LOG_LEVEL=INFO
# PINAX_LOG_FORMAT=text
# PINAX_LOG_FILE=
# PINAX_LOG_REQUESTS=true
# PINAX_SLOW_REQUEST_SECONDS=5
# PINAX_AUDIT_LOG=

# Metrics: /metrics for Prometheus, only with this token (unset: off)
# PINAX_METRICS_TOKEN=
