# Pinax settings. Copy to .env and change what you need; every value shown is the default.

# PINAX_ENVIRONMENT=demo

# Locations
# PINAX_VAR_ROOT=var
# PINAX_SCAN_ROOT=scans
# PINAX_DEMO_ROOT=demo
# PINAX_DATABASE_URL=

# Scanning
# PINAX_FS_INVENTORY=bin/fs-inventory
# PINAX_SCAN_THREADS=32
# PINAX_SCAN_EXTRA_ARGS=[]

# Building indexes
# PINAX_BUILD_MEMORY_LIMIT=8GB
# PINAX_BUILD_THREADS=0
# PINAX_KEEP_SNAPSHOTS=6

# Queries
# PINAX_QUERY_MEMORY_LIMIT=4GB
# PINAX_QUERY_THREADS=0
# PINAX_SEARCH_MAX_ROWS=500
# PINAX_EXPORT_MAX_ROWS=100000
# PINAX_COLD_DAYS=730

# Identity: demo (persona switcher) or header (trust a single sign-on proxy)
# PINAX_AUTH_MODE=demo
# PINAX_AUTH_HEADER=X-Remote-User
# PINAX_TRUSTED_PROXIES='["127.0.0.1", "::1"]'
