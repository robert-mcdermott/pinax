# /etc/pinax/pinax.env: settings for the Pinax services (every setting: docs/CONFIGURATION.md).
PINAX_ENVIRONMENT=prod
PINAX_VAR_ROOT=/var/lib/pinax
PINAX_SCAN_ROOT=/var/lib/pinax/scans

# The catalog: SQLite in PINAX_VAR_ROOT unless this points at PostgreSQL (docs/DEPLOYMENT.md, "PostgreSQL"); the
# password goes in /var/lib/pinax/.pgpass, not here. Upgrades run at start-up unless PINAX_DB_AUTO_UPGRADE=false.
# PINAX_DATABASE_URL=postgresql://pinax@db.example.org/pinax?sslmode=verify-full
# PINAX_DB_AUTO_UPGRADE=true

# Sign-in: passwords Pinax keeps, behind an HTTPS proxy on this host (docs/DEPLOYMENT.md, "6. Signing in"), whose
# X-Forwarded-For gives each person's own address.
PINAX_AUTH_MODE=local
PINAX_TRUSTED_PROXIES='["127.0.0.1", "::1"]'

# Or single sign-on through oauth2-proxy on this host (docs/DEPLOYMENT.md, "Single sign-on with oauth2-proxy"):
# trust the username it sends, and only from it.
# PINAX_AUTH_MODE=header
# PINAX_AUTH_HEADER=X-Forwarded-Preferred-Username

# Sizing (defaults shown; docs/DEPLOYMENT.md, "Sizing").
# PINAX_BUILD_MEMORY_LIMIT=8GB
# PINAX_QUERY_MEMORY_LIMIT=4GB
# PINAX_QUERY_THREADS=0
# PINAX_KEEP_SNAPSHOTS=6

# Long requests (defaults shown): stopped after this many seconds, below oauth2-proxy's upstream_timeout; and how
# many searches and comparisons of a whole filesystem run at once.
# PINAX_QUERY_TIMEOUT=180
# PINAX_WIDE_QUERIES=2
# PINAX_SCAN_THREADS=32

# Logs (defaults shown; docs/DEPLOYMENT.md, "Logs"): the journal by default; JSON lines for a log collector; every
# audit event to a file of its own too, for security monitoring (rotated by deploy/logrotate/pinax).
# PINAX_LOG_FORMAT=text
# PINAX_LOG_FILE=/var/log/pinax/pinax.log
# PINAX_AUDIT_LOG=/var/log/pinax/audit.log
# PINAX_SLOW_REQUEST_SECONDS=5

# API tokens for scripts (default shown): the longest one may last, in days (docs/ADMINISTRATION.md, "API tokens").
# PINAX_TOKEN_MAX_DAYS=365

# Metrics for Prometheus at /metrics, only with this token (docs/DEPLOYMENT.md, "Metrics"); unset, /metrics is off.
# PINAX_METRICS_TOKEN=
