# oauth2-proxy for Pinax (if your oauth2-proxy package does not bring its own unit).
[Unit]
Description=oauth2-proxy for Pinax
After=network-online.target pinax-web.service
Wants=network-online.target

[Service]
Type=simple
User=oauth2-proxy
EnvironmentFile=/etc/oauth2-proxy/pinax.env
ExecStart=/usr/local/bin/oauth2-proxy --config=/etc/oauth2-proxy/pinax.cfg
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
